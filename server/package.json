{
	"name": "eval-form-server",
	"version": "1.0.0",
	"description": "Express.js backend for ProjectEVAL evaluation system",
	"main": "src/index.js",
	"type": "module",
	"scripts": {
		"dev": "nodemon src/index.js",
		"start": "node src/index.js",
		"build": "echo 'No build step required for server'",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"migrate": "node migrate.js",
		"migrate:seed": "node migrate.js --seed"
	},
	"dependencies": {
		"@google/generative-ai": "^0.21.0",
		"bcryptjs": "^2.4.3",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"mammoth": "^1.12.0",
		"multer": "^1.4.5-lts.1",
		"nodemailer": "^6.9.16",
		"pg": "^8.18.0"
	},
	"devDependencies": {
		"morgan": "^1.10.1",
		"nodemon": "^3.1.11",
		"supertest": "^7.2.2",
		"vitest": "^4.0.18"
	}
}
